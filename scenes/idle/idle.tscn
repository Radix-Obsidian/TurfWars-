[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/idle/idle_scene.gd" id="1_idle"]

[node name="IdleHub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_idle")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.08, 0.06, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 40

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="BtnBack" type="Button" parent="MarginContainer/VBox/Header"]
custom_minimum_size = Vector2(100, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "< BACK"

[node name="LabelTitle" type="Label" parent="MarginContainer/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.17, 0.91, 0.47, 1)
theme_override_font_sizes/font_size = 24
text = "IDLE HUB"
horizontal_alignment = 2

[node name="CenterBox" type="VBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3
alignment = 1

[node name="LabelStatus" type="Label" parent="MarginContainer/VBox/CenterBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.17, 0.91, 0.47, 1)
theme_override_font_sizes/font_size = 20
text = "GROW • PROCESS • SELL"
horizontal_alignment = 1

[node name="LabelDesc" type="Label" parent="MarginContainer/VBox/CenterBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.75, 1)
theme_override_font_sizes/font_size = 15
text = "Idle production chains & offline progression will be expanded in Phase 3."
horizontal_alignment = 1

[connection signal="pressed" from="MarginContainer/VBox/Header/BtnBack" to="." method="_on_back_pressed"]
