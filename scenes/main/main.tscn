[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0666667, 0.0666667, 0.0862745, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 40

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="HeaderBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="LabelCash" type="Label" parent="MarginContainer/VBox/HeaderBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.823529, 0.247059, 1)
theme_override_font_sizes/font_size = 20
text = "CASH: $500"

[node name="LabelRep" type="Label" parent="MarginContainer/VBox/HeaderBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.690196, 0.14902, 1, 1)
theme_override_font_sizes/font_size = 20
text = "REP: 0"
horizontal_alignment = 2

[node name="TitleBox" type="VBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="LabelTitle" type="Label" parent="MarginContainer/VBox/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.172549, 0.909804, 0.466667, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_font_sizes/font_size = 46
text = "TURF WARS"
horizontal_alignment = 1

[node name="LabelSubtitle" type="Label" parent="MarginContainer/VBox/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.55, 0.65, 1)
theme_override_font_sizes/font_size = 14
text = "STREET ARCADE • BETA v0.1"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="MarginContainer/VBox"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="MenuButtons" type="VBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BtnCampaign" type="Button" parent="MarginContainer/VBox/MenuButtons"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 20
text = "CAMPAIGN MAP"

[node name="BtnBattle" type="Button" parent="MarginContainer/VBox/MenuButtons"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.2, 0.33, 1)
theme_override_font_sizes/font_size = 20
text = "BATTLE (TEST ARENA)"

[node name="BtnIdle" type="Button" parent="MarginContainer/VBox/MenuButtons"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_colors/font_color = Color(0.172549, 0.909804, 0.466667, 1)
theme_override_font_sizes/font_size = 20
text = "IDLE HUB"

[node name="BtnCollection" type="Button" parent="MarginContainer/VBox/MenuButtons"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_colors/font_color = Color(0.690196, 0.14902, 1, 1)
theme_override_font_sizes/font_size = 20
text = "CREW & DECK"

[node name="Spacer2" type="Control" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="TestSection" type="VBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LabelSection" type="Label" parent="MarginContainer/VBox/TestSection"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.7, 1)
theme_override_font_sizes/font_size = 13
text = "[PHASE 0: SAVEMANAGER & ENGINE VERIFICATION]"
horizontal_alignment = 1

[node name="LabelSaveStatus" type="Label" parent="MarginContainer/VBox/TestSection"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.172549, 0.909804, 0.466667, 1)
theme_override_font_sizes/font_size = 14
text = "Status: Ready"
horizontal_alignment = 1
autowrap_mode = 2

[node name="TestButtons" type="HBoxContainer" parent="MarginContainer/VBox/TestSection"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BtnSaveTest" type="Button" parent="MarginContainer/VBox/TestSection/TestButtons"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "SAVE TEST"

[node name="BtnLoadTest" type="Button" parent="MarginContainer/VBox/TestSection/TestButtons"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "LOAD TEST"

[node name="BtnAddCash" type="Button" parent="MarginContainer/VBox/TestSection/TestButtons"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "+$100 CASH"

[connection signal="pressed" from="MarginContainer/VBox/MenuButtons/BtnCampaign" to="." method="_on_campaign_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/MenuButtons/BtnBattle" to="." method="_on_battle_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/MenuButtons/BtnIdle" to="." method="_on_idle_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/MenuButtons/BtnCollection" to="." method="_on_collection_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TestSection/TestButtons/BtnSaveTest" to="." method="_on_save_test_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TestSection/TestButtons/BtnLoadTest" to="." method="_on_load_test_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TestSection/TestButtons/BtnAddCash" to="." method="_on_add_cash_test_pressed"]
