[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle_arena.gd" id="1_arena"]
[ext_resource type="Script" path="res://scripts/battle/arena_view.gd" id="2_view"]
[ext_resource type="Script" path="res://scripts/battle/battle_ai.gd" id="3_ai"]

[node name="Battle" type="Node2D"]
script = ExtResource("1_arena")

[node name="Camera2D" type="Camera2D" parent="."]
anchor_mode = 0

[node name="ArenaView" type="Node2D" parent="."]
script = ExtResource("2_view")

[node name="TowersContainer" type="Node2D" parent="."]

[node name="UnitsContainer" type="Node2D" parent="."]

[node name="ProjectilesContainer" type="Node2D" parent="."]

[node name="VFXContainer" type="Node2D" parent="."]

[node name="BattleAI" type="Node" parent="."]
script = ExtResource("3_ai")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="TopBar" type="MarginContainer" parent="HUD"]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 76.0
grow_horizontal = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16

[node name="HBox" type="HBoxContainer" parent="HUD/TopBar"]
layout_mode = 2

[node name="BtnRetreat" type="Button" parent="HUD/TopBar/HBox"]
custom_minimum_size = Vector2(90, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "< RETREAT"

[node name="Spacer" type="Control" parent="HUD/TopBar/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="LabelCrownsEnemy" type="Label" parent="HUD/TopBar/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.22, 0.35, 1)
theme_override_font_sizes/font_size = 16
text = "ENEMY: 0"

[node name="LabelTimer" type="Label" parent="HUD/TopBar/HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 22
text = "3:00"
horizontal_alignment = 1

[node name="LabelCrownsPlayer" type="Label" parent="HUD/TopBar/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.17, 0.91, 0.47, 1)
theme_override_font_sizes/font_size = 16
text = "PLAYER: 0"

[node name="BannerDoubleElixir" type="Control" parent="HUD"]
unique_name_in_owner = true
visible = false
layout_mode = 3
anchors_preset = 14
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_top = -40.0
offset_bottom = 40.0
grow_horizontal = 2
grow_vertical = 2

[node name="ColorRect" type="ColorRect" parent="HUD/BannerDoubleElixir"]
