[connection signal="pressed" from="HUD/TopBar/HBox/BtnRetreat" to="." method="_on_return_pressed"]
[connection signal="pressed" from="HUD/BottomDock/VBox/DeckContainer/HBox/CardSlotsContainer/CardBtn0" to="." method="_on_card_slot_pressed" binds= [0]]
[connection signal="pressed" from="HUD/BottomDock/VBox/DeckContainer/HBox/CardSlotsContainer/CardBtn1" to="." method="_on_card_slot_pressed" binds= [1]]
